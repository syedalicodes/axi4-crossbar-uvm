SIM ?= verilator
COMPILE_ARGS += --assert

TOPLEVEL_LANG = verilog
VERILOG_SOURCES = $(PWD)/rtl/axi4_crossbar_2x2.sv $(PWD)/tb/sva/axi4_crossbar_sva.sv

TOPLEVEL = axi4_crossbar_2x2
COCOTB_TEST_MODULES = test_crossbar_aw,test_crossbar_random

SIM_BUILD = sim_build_crossbar
PYTHONPATH := $(PWD)/tb/cocotb:$(PYTHONPATH)
export PYTHONPATH

include $(shell cocotb-config --makefiles)/Makefile.sim
